# Settings for the Playwright end-to-end suite. Copy to .env.e2e (gitignored).
# Clerk keys come from .env.local; they must be a Clerk *development* instance.

# Existing Clerk dev-instance users, already members of the same organization
# and synced into the local database (run `pnpm db:sync:clerk` if not).
E2E_ADMIN_EMAIL=admin@example.com
E2E_EMPLOYEE_EMAIL=employee+clerk_test@example.com

# Owner connection to the local dev database (same as DATABASE_URL in
# .env.local.migrate). Tests insert their own data, prefixed "E2E ", and
# delete it afterwards.
E2E_DATABASE_URL=postgresql://turnout:password@localhost:5433/turnout_dev
