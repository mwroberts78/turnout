{
  "name": "turnout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:generate:test": "dotenv -e .env.test -- drizzle-kit generate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "db:studio:test": "dotenv -e .env.test -- drizzle-kit studio",
    "db:generate:prod": "dotenv -e .env.neon.production -- drizzle-kit generate",
    "db:migrate:prod": "dotenv -e .env.neon.production -- drizzle-kit migrate",
    "db:studio:prod": "dotenv -e .env.neon.production -- drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.6.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
